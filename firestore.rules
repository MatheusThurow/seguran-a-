rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /participacoes/{documentId} {
   function ownsPath(){return request.auth != null && documentId.matches(request.auth.uid + '_[a-f0-9-]{36}');}
   function validAnswers(a){return a is list && a.size()==3 && a[0] in [0,1,2] && a[1] in [0,1,2] && a[2] in [0,1,2];}
   allow get: if ownsPath();
   allow create: if ownsPath()
    && request.resource.data.keys().hasAll(['id','version','pre_answers','pre_score','post_answers','post_score','outcome','analysis_ms','events','uid','created_at'])
    && request.resource.data.keys().hasOnly(['id','version','pre_answers','pre_score','post_answers','post_score','outcome','analysis_ms','events','uid','created_at'])
    && request.resource.data.uid == request.auth.uid
    && documentId == request.auth.uid + '_' + request.resource.data.id
    && request.resource.data.version is string && request.resource.data.version.size() <= 40
    && validAnswers(request.resource.data.pre_answers) && validAnswers(request.resource.data.post_answers)
    && request.resource.data.pre_score is int && request.resource.data.pre_score >= 0 && request.resource.data.pre_score <= 3
    && request.resource.data.post_score is int && request.resource.data.post_score >= 0 && request.resource.data.post_score <= 3
    && request.resource.data.outcome in ['purchase','quit']
    && request.resource.data.analysis_ms is int && request.resource.data.analysis_ms >= 0
    && request.resource.data.events is list && request.resource.data.events.size() <= 50
    && request.resource.data.created_at == request.time;
   allow list, update, delete: if false;
  }
 }
}
